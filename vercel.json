{
  "version": 2,
  "functions": {
    "api/**/*.py": {
      "includeFiles": "app/**",
      "excludeFiles": "tests/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ]
}
